{
  "name": "pokemon-collection-widget",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node cloudflare/sync-backgrounds.cjs && node cloudflare/build.cjs",
    "sync:backgrounds": "node cloudflare/sync-backgrounds.cjs",
    "deploy": "wrangler deploy --config cloudflare/worker.wrangler.jsonc",
    "dev": "wrangler dev --config cloudflare/worker.wrangler.jsonc",
    "test": "node --test audit/collection/*.test.mjs"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
